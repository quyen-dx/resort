# ========================================================
# RESORT ECOSYSTEM ENVIRONMENT CONFIGURATION (SAMPLE / EXAMPLE)
# DO NOT COMMIT REAL SECRETS TO REPOSITORY (SEC-01)
# ========================================================

# Runtime Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL Database Connection (DB-01)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/resort_db?schema=public

# Session & Security (SEC-02, SEC-03)
# Generate 64-character random string for production
SESSION_SECRET=mock_super_secret_session_key_min_32_characters_long_12345
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Transport Service Integration (INT-01)
# Sandbox mock provider (Not affiliated with live Xanh SM / VinFast APIs)
TRANSPORT_API_MODE=sandbox
TRANSPORT_MOCK_BASE_RATE_PER_KM=4000

# Observability & Logging (OBS-01)
LOG_LEVEL=debug
